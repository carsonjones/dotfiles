// Zellij config translated from prise init.lua
// Leader: Space (zellij uses a "tmux"-style prefix Ctrl+b by default; we use the locked-mode style mapping below)

// --- Theme: ported from prise (atom-one-dark-ish) ---
themes {
    prise {
        fg "#abb2bf"          // fg_bright
        bg "#252A34"          // bg1
        black "#181a1f"       // fg_dark
        red "#e06c75"
        green "#98c379"       // green
        yellow "#e5c07b"      // yellow / mode_command
        blue "#61afef"        // accent / mode_normal
        magenta "#c678dd"
        cyan "#56b6c2"
        white "#abb2bf"
        orange "#d19a66"
    }
}
theme "prise"

// Pane frames similar to prise borders.enabled=true, mode=separator, style=single
pane_frames true
simplified_ui false
default_layout "default"
mouse_mode true
copy_on_select true
scroll_buffer_size 10000
mirror_session false
session_serialization true
serialize_pane_viewport true
scrollback_lines_to_serialize 1000

// Use Ctrl+Space as the prefix (Space alone conflicts with shells); inside locked-then-prefix flow,
// or use the modal default. Below we keep zellij's modal model and add prise-style bindings.

keybinds clear-defaults=true {
    // Common to all modes: escape to Normal, quit, detach
    shared_except "locked" {
        bind "Ctrl g" { SwitchToMode "Locked"; }
        bind "Ctrl q" { Quit; }
        bind "Alt n" { NewPane; }
        bind "Alt h" { MoveFocusOrTab "Left"; }
        bind "Alt l" { MoveFocusOrTab "Right"; }
        bind "Alt j" { MoveFocus "Down"; }
        bind "Alt k" { MoveFocus "Up"; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt [" { PreviousSwapLayout; }
        bind "Alt ]" { NextSwapLayout; }
    }
    shared_except "normal" "locked" {
        bind "Enter" "Esc" { SwitchToMode "Normal"; }
    }
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }
    normal {
        // Leader = Space (prise-style). Press <Space> to enter Tmux mode briefly.
        bind "Space" { SwitchToMode "Tmux"; }
    }
    // "Tmux" mode behaves as our <leader>-prefix layer
    tmux {
        // splits (prise: <leader>v vertical-split, <leader>s horizontal-split, <leader>Enter auto)
        bind "v" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "s" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "Enter" { NewPane; SwitchToMode "Normal"; }

        // focus
        bind "h" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "j" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "l" { MoveFocus "Right"; SwitchToMode "Normal"; }

        // pane mgmt
        bind "w" { CloseFocus; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "f" { ToggleFloatingPanes; SwitchToMode "Normal"; }

        // tabs (prise: t/c/r/n/p, 1..9,0, < >)
        bind "t" { NewTab; SwitchToMode "Normal"; }
        bind "c" { CloseTab; SwitchToMode "Normal"; }
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "n" { GoToNextTab; SwitchToMode "Normal"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "," { MoveTab "Left"; SwitchToMode "Normal"; }    // <leader>< swap_tab_left
        bind "." { MoveTab "Right"; SwitchToMode "Normal"; }   // <leader>> swap_tab_right
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        bind "0" { GoToTab 10; SwitchToMode "Normal"; }

        // resize (prise: <leader>H/L/J/K)
        bind "H" { Resize "Left"; }
        bind "L" { Resize "Right"; }
        bind "J" { Resize "Down"; }
        bind "K" { Resize "Up"; }
        bind "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }

        // sessions (prise: <leader>d detach, <leader>S switch_session, <leader>q quit)
        bind "d" { Detach; }
        bind "S" { SwitchToMode "Session"; }
        bind "q" { Quit; }

        // command palette-ish: zellij has no built-in palette; open session manager as the closest
        bind "Space" { Write 32; SwitchToMode "Normal"; } // double-Space sends a literal space
        bind "Esc" { SwitchToMode "Normal"; }
    }
    session {
        bind "h" "Left" { Detach; }                             // detach to session-manager
        bind "s" { SwitchToMode "Scroll"; }                     // not really, placeholder
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal";
        }
    }
}
