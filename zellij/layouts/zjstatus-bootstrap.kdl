layout {
    default_tab_template {
        pane size=20 borderless=true {
            plugin location="file:/Users/jones/src/dotfiles/zellij/plugins/zjstatus.wasm" {
                format_left   "{mode}"
                format_center "{tabs}"
                format_right  "{datetime}"
                format_space  "#[bg=#252A34]"

                border_enabled  "true"
                border_char     "─"
                border_format   "#[fg=#7C7F85]{char}"
                border_position "bottom"

                hide_frame_for_single_pane "false"

                mode_normal       ""
                mode_locked       "#[bg=#252A34,fg=#abb2bf,bold] {name} "
                mode_tmux         "#[bg=#252A34,fg=#e5c07b,bold] {name} "
                mode_session      "#[bg=#252A34,fg=#56b6c2,bold] {name} "
                mode_resize       "#[bg=#252A34,fg=#d19a66,bold] {name} "
                mode_pane         "#[bg=#252A34,fg=#98c379,bold] {name} "
                mode_tab          "#[bg=#252A34,fg=#61afef,bold] {name} "
                mode_scroll       "#[bg=#252A34,fg=#c678dd,bold] {name} "
                mode_enter_search "#[bg=#252A34,fg=#c678dd,bold] {name} "
                mode_search       "#[bg=#252A34,fg=#c678dd,bold] {name} "
                mode_rename_tab   "#[bg=#252A34,fg=#abb2bf,bold] {name} "
                mode_rename_pane  "#[bg=#252A34,fg=#abb2bf,bold] {name} "
                mode_move         "#[bg=#252A34,fg=#d19a66,bold] {name} "
                mode_prompt       "#[bg=#252A34,fg=#abb2bf,bold] {name} "

                tab_normal        "#[bg=#252A34,fg=#7C7F85] {name} "
                tab_active        "#[bg=#252A34,fg=#abb2bf,bold] {name} "

                datetime          "#[bg=#252A34,fg=#7C7F85,bold] {format} "
                datetime_format   "%I:%M %p"
            }
        }
        children
    }
}
