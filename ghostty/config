theme = cursor dark
# palette = 1=#E06C75
background = 252A34
selection-background = 3D5A80

window-colorspace = "display-p3"
font-size = 16
adjust-cell-height = 30%

background-opacity = .96
background-blur-radius = 20
unfocused-split-opacity = 1.0

mouse-hide-while-typing = true

macos-titlebar-style = hidden
macos-titlebar-style = tabs
macos-icon = custom-style
macos-icon-frame = plastic
macos-icon-ghost-color = 21272b
macos-icon-screen-color = 000000

window-padding-x = 7,12
window-padding-y = 7,4

keybind = alt+left=esc:B
keybind = alt+right=esc:F
keybind = cmd+backspace=esc:W

# Mac keyboards have no End key, so ctrl+End never reaches herdr's
# "jump to bottom". Send the literal ctrl+End CSI sequence on cmd+down.
keybind = cmd+down=text:\x1b[1;5F

# per-machine overrides, gitignored (*.local). ? = ok if missing
config-file = ?config.local
