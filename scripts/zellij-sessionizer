#!/usr/bin/env bash

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_ROOT="${DOTFILES:-$(cd -- "$SCRIPT_DIR/.." && pwd)}"
SEARCH_PATHS_DEFAULT="$HOME/src $HOME/main"
SPECIFIC_PATHS_DEFAULT="$DOTFILES_ROOT $DOTFILES_ROOT/nvim"
IFS=' ' read -r -a SEARCH_PATHS <<< "${ZELLIJ_SESSIONIZER_SEARCH_PATHS:-$SEARCH_PATHS_DEFAULT}"
IFS=' ' read -r -a SPECIFIC_PATHS <<< "${ZELLIJ_SESSIONIZER_SPECIFIC_PATHS:-$SPECIFIC_PATHS_DEFAULT}"
OS_TYPE="${ZELLIJ_SESSIONIZER_OS_TYPE:-"$(uname)"}"

get_atime() {
	local dir="$1"
	if [[ "$OS_TYPE" == "Linux" ]]; then
		stat -c "%X" "$dir" 2>/dev/null || echo "0"
	else
		stat -f "%a" "$dir" 2>/dev/null || echo "0"
	fi
}

select_dir() {
  local selected_dir="$1"
  local session_name
  local session_line
  session_name=$(basename "$selected_dir")

  if [[ -n "${ZELLIJ:-}" ]]; then
    zellij action switch-session --cwd "$selected_dir" "$session_name"
  else
    session_line="$(zellij list-sessions --no-formatting 2>/dev/null | rg "^${session_name}(\\s|$)" | head -n 1)"

    if [[ -n "$session_line" && "$session_line" != *"(EXITED"* ]]; then
      zellij attach "$session_name"
    else
      if [[ -n "$session_line" && "$session_line" == *"(EXITED"* ]]; then
        zellij delete-session "$session_name" --force >/dev/null 2>&1
      fi
      zellij attach --create "$session_name"
    fi
  fi
}

# Function to extract session name from display line
extract_session_name() {
  local display_line="$1"
  # Remove both colored and plain status information
  local clean_path=$(echo "$display_line" | sed 's/ \x1b\[[0-9;]*m([^)]*)\x1b\[[0-9;]*m$//' | sed 's/ ([^)]*)$//')
  local full_path
  if [[ "$clean_path" == ~* ]]; then
    full_path="$HOME${clean_path:1}"
  else
    full_path="$clean_path"
  fi
  basename "$full_path"
}

collect_dirs() {
  local all_dirs=()

  for search_path in "${SEARCH_PATHS[@]}"; do
    if [[ -d "$search_path" ]]; then
      for dir in "$search_path"/*; do
        if [[ -d "$dir" ]]; then
          all_dirs+=("$dir")
        fi
      done
    fi
  done

  for specific_path in "${SPECIFIC_PATHS[@]}"; do
    if [[ -d "$specific_path" ]]; then
      all_dirs+=("$specific_path")
    fi
  done

  printf '%s\n' "${all_dirs[@]}"
}

get_session_status_suffix() {
  local session_name="$1"
  local line

  command -v zellij >/dev/null 2>&1 || return 0

  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    [[ "$(echo "$line" | awk '{print $1}')" == "$session_name" ]] || continue

    if [[ "$line" == *"(current)"* ]]; then
      printf ' %s(current)%s' "$(tput setaf 2)" "$(tput sgr0)"
    elif [[ "$line" == *"(EXITED"* ]]; then
      printf ' %s(exited)%s' "$(tput setaf 1)" "$(tput sgr0)"
    else
      printf ' %s(active)%s' "$(tput setaf 3)" "$(tput sgr0)"
    fi
    return 0
  done < <(zellij ls -n 2>/dev/null)
}

# Function to generate the display list
generate_display_list() {
  local all_dirs=()
  local dir

  while IFS= read -r dir; do
    [[ -n "$dir" ]] && all_dirs+=("$dir")
  done < <(collect_dirs)

  local temp_file=$(mktemp)
  for dir in "${all_dirs[@]}"; do
    local atime=$(get_atime "$dir")
    echo "$atime $dir" >> "$temp_file"
  done

  local sorted_dirs=()
  while IFS= read -r line; do
    local dir_name="${line#* }"
    sorted_dirs+=("$dir_name")
  done < <(sort -nr "$temp_file")

  rm -f "$temp_file"

  for dir in "${sorted_dirs[@]}"; do
    local display_name=$(echo "$dir" | sed "s|^$HOME|~|")
    local session_name=$(basename "$dir")
    local status_suffix

    status_suffix=$(get_session_status_suffix "$session_name")
    if [[ -n "$status_suffix" ]]; then
      display_name="${display_name}${status_suffix}"
    fi

    echo "$display_name"
  done
}

get_most_recent_dir() {
  local all_dirs=()
  local dir

  while IFS= read -r dir; do
    [[ -n "$dir" ]] && all_dirs+=("$dir")
  done < <(collect_dirs)

  local temp_file
  temp_file=$(mktemp)
  for dir in "${all_dirs[@]}"; do
    local atime
    atime=$(get_atime "$dir")
    echo "$atime $dir" >> "$temp_file"
  done

  local most_recent_dir
  most_recent_dir=$(sort -nr "$temp_file" | head -n 1 | cut -d' ' -f2-)
  rm -f "$temp_file"

  if [[ -n "$most_recent_dir" ]]; then
    printf '%s\n' "$most_recent_dir"
  fi
}

if [[ "$1" == "--generate-list" ]]; then
  generate_display_list
  exit 0
fi

if [[ "$1" == "--most-recent" ]]; then
  selected_dir=$(get_most_recent_dir)
  if [[ -z "$selected_dir" ]]; then
    exit 0
  fi

  select_dir "$selected_dir"
  exit 0
fi

# Create a temporary script for session operations
temp_script=$(mktemp)
cat > "$temp_script" << 'EOF'
#!/usr/bin/env bash

# Extract session name from display line
extract_session_name() {
  local display_line="$1"
  # Remove both colored and plain status information
  local clean_path=$(echo "$display_line" | sed 's/ \x1b\[[0-9;]*m([^)]*)\x1b\[[0-9;]*m$//' | sed 's/ ([^)]*)$//')
  local full_path
  if [[ "$clean_path" == ~* ]]; then
    full_path="$HOME${clean_path:1}"
  else
    full_path="$clean_path"
  fi
  basename "$full_path"
}

# Handle delete session
if [[ "$1" == "delete" ]]; then
  session_name=$(extract_session_name "$2")
  if [[ -n "$session_name" ]]; then
    zellij delete-session "$session_name" --force 2>/dev/null
  fi
fi

# Handle kill session  
if [[ "$1" == "kill" ]]; then
  session_name=$(extract_session_name "$2")
  if [[ -n "$session_name" ]]; then
    zellij kill-session "$session_name" 2>/dev/null
  fi
fi
EOF

chmod +x "$temp_script"

# Use fzf with key bindings for session management
selected_display=$(generate_display_list | fzf --ansi \
  --prompt="Select project: " \
  --header="Enter: Select | Ctrl+D: Delete Session | Ctrl+K: Kill Session" \
  --bind="ctrl-d:execute($temp_script delete {})+reload($0 --generate-list)" \
  --bind="ctrl-k:execute($temp_script kill {})+reload($0 --generate-list)")

# Clean up temp script
rm -f "$temp_script"

# Exit if nothing was selected
if [[ -z "$selected_display" ]]; then
  exit 0
fi

# Convert selected display name back to full path
# Remove status information if present (including color codes)
clean_display=$(echo "$selected_display" | sed 's/ \x1b\[[0-9;]*m([^)]*)\x1b\[[0-9;]*m$//' | sed 's/ ([^)]*)$//')

if [[ "$clean_display" == ~* ]]; then
  selected_dir="$HOME${clean_display:1}"
else
  selected_dir="$clean_display"
fi

# Create session name from directory basename
select_dir "$selected_dir"
