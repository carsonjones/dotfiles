# Keep zsh-histdb's internal sqlite calls off wrapper/shim paths that can
# prompt during restored zellij startup.
sqlite3() {
  local sqlite_bin

  for sqlite_bin in \
    /opt/homebrew/opt/sqlite/bin/sqlite3 \
    /usr/local/opt/sqlite/bin/sqlite3 \
    /usr/bin/sqlite3
  do
    if [[ -x "$sqlite_bin" ]]; then
      command "$sqlite_bin" "$@"
      return $?
    fi
  done

  sqlite_bin="$(whence -p sqlite3 2>/dev/null)" || return 127
  command "$sqlite_bin" "$@"
}

