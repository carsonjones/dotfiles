unalias vf 2>/dev/null
vf() {
  local selected

  if (( $# == 0 )) || [[ "$1" == -* ]]; then
    selected="$(fzf "$@")"
  else
    selected="$(fzf -q "$*")"
  fi

  [[ -n "$selected" ]] && nvim --server "$NVIM" --remote-tab "$selected"
}

