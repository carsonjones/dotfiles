symlinks() {
    local root="${1:-/}"

    find "$root" -type l 2>/dev/null | while IFS= read -r link; do
        local target status
        target=$(readlink "$link")
        if [[ ! -e "$link" ]]; then
            status="BROKEN"
        else
            status="OK"
        fi
        printf "%s\t%s\t%s\n" "$status" "$link" "$target"
    done | column -t -s $'\t'
}

