## General
__smart_exit() {
  local mode="detach"

  if [[ "${1:-}" == "--kill-session" ]]; then
    mode="kill"
    shift
  fi

  if [[ -n "${ZELLIJ:-}" ]] && command -v zellij >/dev/null 2>&1; then
    __zellij_safe_exit "$mode"
    return $?
  fi
  builtin exit "$@"
}

__detach_or_exit() {
  if [[ -n "${ZELLIJ:-}" ]] && command -v zellij >/dev/null 2>&1; then
    zellij action detach >/dev/null 2>&1
    return $?
  fi
  builtin exit "$@"
}

