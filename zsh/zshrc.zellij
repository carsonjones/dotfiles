__zellij_is_last_pane() {
  [[ -n "${ZELLIJ:-}" ]] || return 1

  local panes_json tabs_json pane_count tab_count
  panes_json="$(zellij action list-panes --json --state --tab 2>/dev/null)" || return 1
  tabs_json="$(zellij action list-tabs --json --state --panes 2>/dev/null)" || return 1

  if command -v jq >/dev/null 2>&1; then
    pane_count="$(
      printf '%s' "$panes_json" | jq -r '
        def panes:
          if type == "array" then
            .
          elif type == "object" and has("panes") then
            .panes
          else
            []
          end;

        panes as $panes
        | ($panes | map(select((.is_focused // false) and ((.is_exited // false) | not))) | first) as $focused
        | if $focused == null then
            0
          else
            $panes
            | map(
                select(((.is_exited // false) | not))
                | select(
                    if ($focused.tab_position? // null) != null and (.tab_position? // null) != null then
                      .tab_position == $focused.tab_position
                    elif ($focused.tab_id? // null) != null and (.tab_id? // null) != null then
                      .tab_id == $focused.tab_id
                    elif ($focused.tab_name? // null) != null and (.tab_name? // null) != null then
                      .tab_name == $focused.tab_name
                    else
                      .pane_id == $focused.pane_id
                    end
                  )
              )
            | length
          end
      ' 2>/dev/null
    )"

    tab_count="$(
      printf '%s' "$tabs_json" | jq -r '
        def tabs:
          if type == "array" then
            .
          elif type == "object" and has("tabs") then
            .tabs
          else
            []
          end;

        tabs
        | map(
            select(
              ((.active_panes // .panes // .pane_count // 0) | tonumber? // 0) > 0
            )
          )
        | length
      ' 2>/dev/null
    )"
  else
    pane_count="0"
    tab_count="0"
  fi

  [[ "$pane_count" == "1" && "$tab_count" == "1" ]]
}

__zj_most_recent_session_name() {
  local session_line

  session_line="$(
    zellij list-sessions --no-formatting --reverse 2>/dev/null \
      | rg -v '\(EXITED' \
      | head -n 1
  )"

  if [[ -z "$session_line" ]]; then
    session_line="$(
      zellij list-sessions --no-formatting --reverse 2>/dev/null \
        | head -n 1
    )"
  fi

  [[ -n "$session_line" ]] || return 1
  printf '%s\n' "${session_line%% *}"
}

zj() {
  local session_name

  if [[ "$#" -eq 0 ]]; then
    session_name="$(__zj_most_recent_session_name)"

    if [[ -n "$session_name" ]]; then
      if [[ -n "${ZELLIJ:-}" ]]; then
        zellij action switch-session "$session_name"
      else
        zellij attach "$session_name"
      fi
    else
      zellij
    fi
    return
  fi

  case "$1" in
    -n|-a|new)
      shift
      session_name="${1:-}"

      if [[ -n "$session_name" ]]; then
        if [[ -n "${ZELLIJ:-}" ]]; then
          zellij action switch-session --cwd "$PWD" "$session_name"
        else
          zellij attach --create "$session_name"
        fi
      else
        zellij
      fi
      return
      ;;
  esac

  zellij "$@"
}

zjn() {
  local session_name="${1:-$(basename "$PWD")}"

  if [[ -n "${ZELLIJ:-}" ]]; then
    zellij action switch-session --cwd "$PWD" "$session_name"
  else
    zellij attach --create "$session_name"
  fi
}

__zj_set_tab_name() {
  [[ -n "${ZELLIJ:-}" ]] || return
  local base candidate n tabs_json other_names
  base="$(basename "$PWD")"

  tabs_json="$(zellij action list-tabs --json 2>/dev/null)"

  if [[ -n "$tabs_json" ]] && command -v jq >/dev/null 2>&1; then
    other_names="$(printf '%s' "$tabs_json" | jq -r '.[] | select(.active // false | not) | .name // empty' 2>/dev/null)"
    candidate="$base"
    n=2
    while printf '%s\n' "$other_names" | grep -qx "$candidate"; do
      candidate="${base} ${n}"
      (( n++ ))
    done
  else
    candidate="$base"
  fi

  zellij action rename-tab "$candidate" 2>/dev/null
}
add-zsh-hook chpwd __zj_set_tab_name
__zj_set_tab_name

zr() {
  local dotfiles_root="${DOTFILES:-$HOME/src/dotfiles}"
  local args=()

  if [[ -n "${ZELLIJ_SESSION_NAME:-}" ]]; then
    args=(--session "$ZELLIJ_SESSION_NAME")
  fi

  zellij "${args[@]}" action start-or-reload-plugin "file:$dotfiles_root/zellij/plugins/zjstatus.wasm" &&
    zellij "${args[@]}" action override-layout "$dotfiles_root/zellij/layouts/zjstatus.kdl"
}
