__zellij_current_tab_pane_count() {
  [[ -n "${ZELLIJ:-}" ]] || return 1

  local panes_json pane_count
  panes_json="$(zellij action list-panes --json --state --tab 2>/dev/null)" || return 1
  command -v jq >/dev/null 2>&1 || return 1

  pane_count="$(
    printf '%s' "$panes_json" | jq -r '
      def panes:
        if type == "array" then .
        elif type == "object" and has("panes") then .panes
        else []
        end;

      panes | map(select(((.is_exited // false) | not))) | length
    ' 2>/dev/null
  )" || return 1

  [[ "$pane_count" == <-> ]] || return 1
  printf '%s\n' "$pane_count"
}

__zellij_tab_count() {
  [[ -n "${ZELLIJ:-}" ]] || return 1

  local tabs_json tab_count
  tabs_json="$(zellij action list-tabs --json --state --panes 2>/dev/null)" || return 1
  command -v jq >/dev/null 2>&1 || return 1

  tab_count="$(
    printf '%s' "$tabs_json" | jq -r '
      if type == "array" then length
      elif type == "object" and has("tabs") then .tabs | length
      else 0
      end
    ' 2>/dev/null
  )" || return 1

  [[ "$tab_count" == <-> ]] || return 1
  printf '%s\n' "$tab_count"
}

__zellij_safe_exit() {
  [[ -n "${ZELLIJ:-}" ]] || return 1

  local mode="${1:-detach}"
  local pane_count tab_count
  pane_count="$(__zellij_current_tab_pane_count)" || return 1
  tab_count="$(__zellij_tab_count)" || return 1

  if (( pane_count > 1 )); then
    zellij action close-pane >/dev/null 2>&1
  elif (( tab_count > 1 )); then
    zellij action close-tab >/dev/null 2>&1
  elif [[ "$mode" == "kill" ]]; then
    # Last pane + last tab: killing ends the whole session, so confirm first.
    local REPLY target="${ZELLIJ_SESSION_NAME:-this session}"
    if ! read -q "REPLY?kill ${target}? [y/N] "; then
      print
      return 0
    fi
    print
    if [[ -n "${ZELLIJ_SESSION_NAME:-}" ]]; then
      zellij kill-session "$ZELLIJ_SESSION_NAME" >/dev/null 2>&1
    else
      zellij action close-pane >/dev/null 2>&1
    fi
  else
    zellij action detach >/dev/null 2>&1
  fi
}

__zellij_is_last_pane() {
  [[ -n "${ZELLIJ:-}" ]] || return 1

  local pane_count tab_count
  pane_count="$(__zellij_current_tab_pane_count)" || return 1
  tab_count="$(__zellij_tab_count)" || return 1

  (( pane_count == 1 && tab_count == 1 ))
}

__zj_session_line() {
  local session_name="$1"

  zellij list-sessions --no-formatting 2>/dev/null \
    | while IFS= read -r line; do
        [[ "${line%% *}" == "$session_name" ]] && printf '%s\n' "$line" && return 0
      done
}

__zj_delete_exited_session() {
  local session_name="$1"
  local session_line

  session_line="$(__zj_session_line "$session_name")"
  [[ "$session_line" == *"(EXITED"* ]] || return 0

  zellij delete-session "$session_name" --force >/dev/null 2>&1
}

__zj_most_recent_live_session_name() {
  local session_line

  session_line="$(
    zellij list-sessions --no-formatting --reverse 2>/dev/null \
      | rg -v '\(EXITED' \
      | head -n 1
  )"

  [[ -n "$session_line" ]] || return 1
  printf '%s\n' "${session_line%% *}"
}

zj() {
  local session_name

  if [[ "$#" -eq 0 ]]; then
    session_name="$(__zj_most_recent_live_session_name)"

    if [[ -n "$session_name" ]]; then
      if [[ -n "${ZELLIJ:-}" ]]; then
        zellij action switch-session "$session_name"
      else
        zellij attach "$session_name"
      fi
    else
      zellij
    fi
    return
  fi

  case "$1" in
    -n|-a|new)
      shift
      session_name="${1:-$(basename "$PWD")}"

      __zj_delete_exited_session "$session_name"

      if [[ -n "${ZELLIJ:-}" ]]; then
        zellij action switch-session --cwd "$PWD" "$session_name"
      else
        zellij attach --create "$session_name"
      fi
      return
      ;;
  esac

  zellij "$@"
}

zjn() {
  local session_name="${1:-$(basename "$PWD")}"

  __zj_delete_exited_session "$session_name"

  if [[ -n "${ZELLIJ:-}" ]]; then
    zellij action switch-session --cwd "$PWD" "$session_name"
  else
    zellij attach --create "$session_name"
  fi
}

__zj_is_default_tab_name() {
  [[ "$1" == Tab\ \#<-> ]]
}

__zj_is_auto_tab_name_for_pwd() {
  local base="$1"
  local tab_name="$2"

  [[ "$tab_name" == "$base" || "$tab_name" == "$base "<-> ]]
}

__zj_set_tab_name() {
  [[ -n "${ZELLIJ:-}" ]] || return
  local base candidate n tabs_json active_name other_names
  base="$(basename "$PWD")"

  tabs_json="$(zellij action list-tabs --json 2>/dev/null)"

  if [[ -n "$tabs_json" ]] && command -v jq >/dev/null 2>&1; then
    active_name="$(printf '%s' "$tabs_json" | jq -r '.[] | select(.active // false) | .name // empty' 2>/dev/null | head -n 1)"

    if [[ -n "$active_name" ]]; then
      if [[ -n "${__ZJ_AUTO_TAB_NAME:-}" ]]; then
        [[ "$active_name" == "$__ZJ_AUTO_TAB_NAME" ]] || return
      elif ! __zj_is_default_tab_name "$active_name" && ! __zj_is_auto_tab_name_for_pwd "$base" "$active_name"; then
        return
      fi
    fi

    other_names="$(printf '%s' "$tabs_json" | jq -r '.[] | select(.active // false | not) | .name // empty' 2>/dev/null)"
    candidate="$base"
    n=2
    while printf '%s\n' "$other_names" | grep -qx "$candidate"; do
      candidate="${base} ${n}"
      (( n++ ))
    done
  else
    candidate="$base"
  fi

  zellij action rename-tab "$candidate" 2>/dev/null
  typeset -g __ZJ_AUTO_TAB_NAME="$candidate"
}
autoload -Uz add-zsh-hook
add-zsh-hook chpwd __zj_set_tab_name
__zj_set_tab_name

zr() {
  local dotfiles_root="${DOTFILES:-$HOME/src/dotfiles}"
  local args=()

  if [[ -n "${ZELLIJ_SESSION_NAME:-}" ]]; then
    args=(--session "$ZELLIJ_SESSION_NAME")
  fi

  zellij "${args[@]}" action start-or-reload-plugin "file:$dotfiles_root/zellij/plugins/zjstatus.wasm" &&
    zellij "${args[@]}" action override-layout "$dotfiles_root/zellij/layouts/zjstatus.kdl"
}
